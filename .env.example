# 复制为 .env 后填写（.env 已被 .gitignore 忽略，切勿提交）

# ---- 数据源（Tushare Pro，17:30 拉取当日日线）----
TUSHARE_TOKEN=

# 监控票池（逗号分隔，Tushare 代码格式：600519.SH / 000001.SZ）
# 建议先用 30-80 只自选池跑稳，再逐步扩到全市场
AQLAB_SYMBOLS=600519.SH,000001.SZ,300750.SZ
AQLAB_START=2023-01-01

# ---- 飞书自定义机器人 webhook（不签名版本）----
# 群设置 → 群机器人 → 添加机器人 → 自定义机器人 → 复制 webhook 地址
FEISHU_WEBHOOK=

# ---- 规则参数覆盖（可选），逗号分隔：规则名.参数=值 ----
# 例：单针下探均线改 30、量价齐升改 3 日确认
# AQLAB_RULE_OVERRIDES=needle_below_ma.ma_window=30,volume_price_surge.confirm_days=3

# ---- 可选：LLM 研究代理（agent / eval --mode live 才需要）----
AQLAB_LLM_API_KEY=
AQLAB_LLM_BASE_URL=https://api.deepseek.com/v1
AQLAB_LLM_MODEL=deepseek-chat

# ---- 可选：输出目录 ----
AQLAB_OUTPUT=output
