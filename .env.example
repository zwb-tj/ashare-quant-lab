# 复制为 .env 后填写（.env 已被 .gitignore 忽略，切勿提交）

# ---- 数据源（Tushare Pro，17:30 拉取当日日线）----
TUSHARE_TOKEN=

# 监控票池（逗号分隔，Tushare 代码格式：600519.SH / 000001.SZ）
# 建议先用 30-80 只自选池跑稳，再逐步扩到全市场
AQLAB_SYMBOLS=600519.SH,000001.SZ,300750.SZ
AQLAB_START=2023-01-01

# 是否额外抓取真实换手率（daily_basic.turnover_rate）：1=开启（0AMV 与简化版 B1 的换手率用真值）
AQLAB_TURNOVER=0

# ---- 飞书自定义机器人 webhook ----
# 群设置 → 群机器人 → 添加机器人 → 自定义机器人 → 复制 webhook 地址
FEISHU_WEBHOOK=
# 若机器人开启"签名校验"，把签名密钥填在这里；不签名版本留空即可
FEISHU_WEBHOOK_SECRET=

# ---- 可选：本地 stockdb 行情库（stockdb-export / 全市场日线用）----
# pybao SDK 目录（默认自动探测仓库同级的 pybao/）
AQLAB_STOCKDB_PYBAO=
# 本地 stockdb HTTP 服务地址（默认 127.0.0.1:7899）
AQLAB_STOCKDB_HTTP=

# ---- 规则档案与开关（可选）----
# 档案：generic | b1 | b2 | b3 | needle_20 | needle_30 | volume_price_v3 | zgnb_full | zgnb_needle30
AQLAB_PROFILE=zgnb_full
# 开关：amv（0AMV 活跃市值波段开关，默认）| activity（通用活跃度）| none
AQLAB_GATE=amv

# ---- 规则参数覆盖（可选），逗号分隔：规则名.参数=值 ----
# 例：B1 的 J 阈值放宽到 -15、单针改成 30 口径
# AQLAB_RULE_OVERRIDES=b1_opportunity.j_max=-15,needle_rsl.short_max=30,needle_rsl.long_min=85

# ---- 可选：LLM 研究代理（agent / eval --mode live 才需要）----
AQLAB_LLM_API_KEY=
AQLAB_LLM_BASE_URL=https://api.deepseek.com/v1
AQLAB_LLM_MODEL=deepseek-chat

# ---- 可选：输出目录 ----
AQLAB_OUTPUT=output
